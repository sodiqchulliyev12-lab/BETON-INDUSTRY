# BETON INDUSTRY — systemd xizmati (VPS). Joylashuvi: /etc/systemd/system/beton-industry.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now beton-industry
#   sudo systemctl status beton-industry
#   sudo journalctl -u beton-industry -f        # loglar
#
# Sozlamalar /opt/beton-industry/backend/.env faylidan o'qiladi (ilovaning o'zi o'qiydi).

[Unit]
Description=BETON INDUSTRY (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=beton
Group=beton
WorkingDirectory=/opt/beton-industry/backend

# Har ishga tushishda yangi migratsiyalar qo'llanadi (yangi migratsiya bo'lmasa hech narsa qilmaydi)
ExecStartPre=/opt/beton-industry/backend/.venv/bin/python -m alembic upgrade head
# Faqat 127.0.0.1 da tinglaydi — tashqaridan faqat nginx orqali kiriladi
ExecStart=/opt/beton-industry/backend/.venv/bin/python -m uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Himoya: ilova faqat rasmlar papkasiga yoza oladi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/beton-industry/backend/uploads

[Install]
WantedBy=multi-user.target
