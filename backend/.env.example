# ============================================================================
# BETON INDUSTRY — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zingiznikiga almashtiring.
# .env fayli HECH QACHON GitHub'ga yuklanmaydi (.gitignore'da).
# ============================================================================

# development | production | test
APP_ENV=development

# PostgreSQL ulanishi. Railway beradigan "postgresql://..." ko'rinishi ham qabul qilinadi.
DATABASE_URL=postgresql+psycopg://beton:beton_password@localhost:5432/beton_industry

# JWT imzosi uchun maxfiy kalit (kamida 32 belgi). Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend qaysi manzillardan API'ga murojaat qila oladi (vergul bilan).
# Frontend FastAPI'ning o'zidan tarqatilsa, bu ro'yxatga ehtiyoj yo'q.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Production: server javob beradigan domenlar (vergul bilan). Bo'sh — cheklanmaydi.
# Masalan: beton.uz,www.beton.uz,beton-industry.up.railway.app
ALLOWED_HOSTS=

# Sanalar shu vaqt zonasi bo'yicha tekshiriladi
TIMEZONE=Asia/Tashkent

# FastAPI frontend/ papkasini o'zi tarqatsinmi (Railway uchun qulay)
SERVE_FRONTEND=true

# Ochiq formalarga so'rovlar sonini cheklash
RATE_LIMIT_ENABLED=true

# Telegram bot tokeni. @BotFather → /newbot orqali olinadi. Bo'sh bo'lsa xabarnomalar yuborilmaydi.
# Token MAXFIY: faqat shu faylda saqlanadi, admin panelga ham, bazaga ham yozilmaydi.
TELEGRAM_BOT_TOKEN=

# Saytning ommaviy manzili — Telegram xabaridagi «Admin panelda ochish» havolasi uchun (ixtiyoriy)
PUBLIC_BASE_URL=
